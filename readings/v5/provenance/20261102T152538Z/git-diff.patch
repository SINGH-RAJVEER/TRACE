+# An empty PATTERN only requires success: vLLM's /health answers 200 with an empty body.
 wait_http() { # URL PATTERN SECONDS [PID]
 	local deadline=$((SECONDS + $3))
-	until curl -fsS "$1" 2>/dev/null | grep -q -- "$2"; do
