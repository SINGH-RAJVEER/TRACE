# Shell scripts must keep LF endings, or bash fails on Windows checkouts used from WSL.
*.sh text eol=lf
justfile text eol=lf

# Recorded study data lives in Git LFS.
readings/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
readings/**/*.json filter=lfs diff=lfs merge=lfs -text
readings/**/*.npy filter=lfs diff=lfs merge=lfs -text
readings/**/*.log filter=lfs diff=lfs merge=lfs -text

# Archived model weights, training state and databases belong in LFS too.
readings/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
readings/**/*.pt filter=lfs diff=lfs merge=lfs -text
readings/**/*.pth filter=lfs diff=lfs merge=lfs -text
readings/**/*.bin filter=lfs diff=lfs merge=lfs -text
readings/**/*.tar filter=lfs diff=lfs merge=lfs -text
readings/**/*.sqlite filter=lfs diff=lfs merge=lfs -text
readings/**/*.sqlite3 filter=lfs diff=lfs merge=lfs -text

# Preserve the original archive's LFS layout, including bundled run inputs.
readings/raw-2026-11-02/** filter=lfs diff=lfs merge=lfs -text
readings/raw-2026-11-02/README.md !filter !diff !merge text
readings/raw-2026-11-02/MANIFEST.tsv !filter !diff !merge text
readings/v3-2026-10-29-gateway-replay/run/tasks/** filter=lfs diff=lfs merge=lfs -text
readings/v3-2026-10-29-gateway-replay/students/** filter=lfs diff=lfs merge=lfs -text
