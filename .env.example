# Serve an OpenAI-compatible teacher separately, for example using vLLM.
TEACHER_UPSTREAM_BASE_URL=http://127.0.0.1:8001/v1
TEACHER_UPSTREAM_API_KEY=
TEACHER_UPSTREAM_MODEL=Qwen/Qwen3.5-9B
TEACHER_PROVIDER_NAME=self-hosted-vllm
TEACHER_TERMS_REVIEW_ID=
TEACHER_API_TOKEN=
TEACHER_HOST=127.0.0.1
TEACHER_PORT=8000

# Reasoning is on by default and never returned; the budget rides on each answer cap.
# TEACHER_ENABLE_THINKING=true
# TEACHER_REASONING_BUDGET_TOKENS=2048
# Optional keyed watermark; keep the hex secret file out of readings. See docs/watermark.md.
# TEACHER_WATERMARK_KEY_FILE=artifacts/watermark.key
# TEACHER_WATERMARK_GAMMA=0.25
# TEACHER_WATERMARK_DELTA=2.0
# TEACHER_WATERMARK_ELIGIBLE_VOCAB=32768

# Use distinct account credentials for a protected campaign.
HARNESS_CALIBRATION_DIR=artifacts/harness
HARNESS_TEACHER_URL=http://127.0.0.1:8000
HARNESS_TEACHER_TOKEN=
HARNESS_ACCOUNTS_FILE=
HARNESS_POLICY=mmd
HARNESS_ACCUMULATOR=paper
HARNESS_L4_ACTION=refuse
# Opt in to per-request verification at detector-driven L3 and L4.
HARNESS_POLICY_VERSION=legacy-v1
HARNESS_TASK=gateway
HARNESS_GATEWAY_CAPS={"ag_news":256,"squad":256,"gsm8k":1024,"coding":1024}
HARNESS_DECISION_LOG=artifacts/harness/decisions.jsonl
HARNESS_PORT=8003

# Product entry point: generate the config with
# just campaign-config artifacts/campaign/config.json --namespace my-deployment
# just start uses base policy allow unless --base-policy explicitly selects another.
# Calibration matching HARNESS_TASK and authenticated accounts are still required.
# HARNESS_CAMPAIGN_CONFIG=artifacts/campaign/config.json
# HARNESS_STATE_DB=artifacts/campaign/state.sqlite3
# Experimental throttle mode requires this explicit diagnostic override:
# HARNESS_CAMPAIGN_ALLOW_UNQUALIFIED_ENFORCEMENT=true
# just study disables these campaign settings in its historical comparison arms.

# Opt in to cross-request microbatching with a positive wait. Use cuda only on a qualified GPU host.
HARNESS_ENCODER_DEVICE=cpu
HARNESS_ENCODER_BATCH_SIZE=64
HARNESS_ENCODER_BATCH_WAIT_MS=0
HARNESS_ENCODER_QUEUE_CAPACITY=1024

# Experimental off-path scoring changes policy timing and needs separate calibration.
HARNESS_SCORING_MODE=synchronous
HARNESS_SCORING_QUEUE_CAPACITY=128

# Optional durable acquisition accounting. Unset limits preserve the existing behavior.
# Use a new state file for each arm.
# HARNESS_STATE_DB=artifacts/harness/state-ARM.sqlite3
# HARNESS_OUTPUT_TOKEN_BUDGET=100000
# HARNESS_ORGANIZATION_TOKEN_BUDGET=500000
# HARNESS_IN_FLIGHT_LIMIT=4
# HARNESS_RESERVATION_LEASE_SECONDS=600
# Limits over a rolling window, which a horizon does not renew. They need HARNESS_STATE_DB.
# HARNESS_ROLLING_WINDOW_SECONDS=604800
# HARNESS_ROLLING_REQUEST_BUDGET=
# HARNESS_ROLLING_TOKEN_BUDGET=
# Shared by the principals of one declared organization in HARNESS_ACCOUNTS_FILE.
# HARNESS_ORGANIZATION_ROLLING_REQUEST_BUDGET=
# HARNESS_ORGANIZATION_ROLLING_TOKEN_BUDGET=
# Accounts JSON accepts digest: "principal" or digest: {"principal":"alice","organization":"org"}.

# Optional supervision-weighted rolling allowance (configure both together).
# HARNESS_ROLLING_SUPERVISION_BUDGET=100000
# HARNESS_SUPERVISION_WEIGHTS_FILE=weights.json
# HARNESS_SUPERVISION_REPEAT_FACTOR=1
# Optional trust tiers and promotion history.
# HARNESS_TRUST_TIERS=true
# HARNESS_NEW_TIER_FRACTION=0.5
# HARNESS_NEW_TIER_MIN_AGE_SECONDS=604800
# HARNESS_NEW_TIER_MIN_RELEASES=10

# Release detail by tier (needs HARNESS_TRUST_TIERS).
# HARNESS_TIER_OUTPUT_CAPS={"new":256,"established":1024}
# HARNESS_SAMPLING_MIN_TIER=established
# Request-path account linkage and shared cluster limits (need HARNESS_STATE_DB).
# HARNESS_LINKAGE_CONFIG=artifacts/linkage.json
# HARNESS_CLUSTER_ROLLING_REQUEST_BUDGET=
# HARNESS_CLUSTER_ROLLING_TOKEN_BUDGET=
# Per-principal watermark keys; the teacher needs TEACHER_WATERMARK_KEY_FILE.
# HARNESS_WATERMARK=false
# HARNESS_WATERMARK_NAMESPACE=trace

# Optional durable operator review. Keep the admin key separate from client keys.
HARNESS_REVIEW_ENABLED=false
HARNESS_REVIEW_ADMIN_KEY=
# JSON array of refusal codes to present as pending verification.
HARNESS_REVIEW_VERIFY_CODES=[]
