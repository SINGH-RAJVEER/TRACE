# Hosted teacher. The endpoint must implement POST /chat/completions.
TEACHER_UPSTREAM_BASE_URL=https://your-approved-provider.example/v1
TEACHER_UPSTREAM_API_KEY=
TEACHER_UPSTREAM_MODEL=provider-model-snapshot
TEACHER_PROVIDER_NAME=approved-provider
TEACHER_TERMS_REVIEW_ID=
TEACHER_TIMEOUT_SECONDS=120

# Optional bearer token required by this repository's teacher API.
TEACHER_API_TOKEN=
TEACHER_HOST=127.0.0.1
TEACHER_PORT=8000
TEACHER_LOG_LEVEL=info
