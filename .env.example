# Teacher: Qwen3.5-9B, non-thinking mode. Same family as the Qwen3.5-2B-Base student
# (compatible chat format). Either self-host with vLLM:
#   vllm serve Qwen/Qwen3.5-9B --revision c202236235762e1c871ad0ccb60c8ee5ba337b9a \
#     --host 127.0.0.1 --port 8001 --language-model-only \
#     --default-chat-template-kwargs '{"enable_thinking": false}'
# and point TEACHER_UPSTREAM_BASE_URL at http://127.0.0.1:8001/v1,
# or use a hosted route whose terms permit distillation output use.
# The endpoint must implement POST /chat/completions.
TEACHER_UPSTREAM_BASE_URL=http://127.0.0.1:8001/v1
TEACHER_UPSTREAM_API_KEY=
TEACHER_UPSTREAM_MODEL=Qwen/Qwen3.5-9B
TEACHER_PROVIDER_NAME=self-hosted-vllm
# Approval reference written into every ledger record; the teacher API and the collector
# refuse to run without it. Use a new value, and a new ledger, when the teacher changes.
TEACHER_TERMS_REVIEW_ID=
TEACHER_TIMEOUT_SECONDS=120

# Bearer token for this repository's teacher API. Optional on loopback; teacher-host requires
# it because it binds to the network. Use the same value on the student machine.
TEACHER_API_TOKEN=
TEACHER_HOST=127.0.0.1
TEACHER_PORT=8000
TEACHER_LOG_LEVEL=info

# Run the full study with just start, or undefended distillation with just distill.
# Each task fixes its own output limit; choose tasks, query budgets, and seeds on the CLI.
DISTILL_CONCURRENCY=4
# Force a runtime: auto, devenv (on NixOS), uv, or pip.
DISTILL_RUNTIME=auto

# The launcher starts vLLM and overrides TEACHER_UPSTREAM_BASE_URL, unless given
# --upstream-url. The URL/model/provider above configure the standalone teacher API too;
# without those settings the API has no upstream URL/model and records provider "unknown".
TEACHER_MODEL_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a
VLLM_PORT=8001
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
# Extra vLLM flags, quoted because just cannot read unquoted values with spaces. They are
# split like a shell command line.
# The BF16 text weights take about 18 GB, so a GPU under 24 GB needs "--quantization fp8".
# A GPU that also drives a display has about 1 GB less free memory; lower
# VLLM_GPU_MEMORY_UTILIZATION if vLLM reports less free memory than it wants.
VLLM_EXTRA_ARGS=
# GiB of system RAM for offloading KV cache blocks from the GPU; empty disables offloading.
# The backend is "native" or "lmcache" (lmcache must be installed into .venv-vllm).
VLLM_KV_OFFLOADING_SIZE=
VLLM_KV_OFFLOADING_BACKEND=native
# Package spec installed into .venv-vllm when vllm is not on PATH. Pin it for paper runs.
VLLM_SPEC=vllm
# Seconds to wait for vLLM to load the model and start serving. The model
# downloads into the Hugging Face cache, with progress, before vLLM starts.
VLLM_STARTUP_TIMEOUT=1800
# Interpreter for .venv-vllm. The devenv shell supplies its Python 3.12 executable path.
VLLM_PYTHON=3.12
# Existing vLLM executable to use instead of PATH or .venv-vllm; no fixed default.
VLLM_BIN=
# Disable model downloads and use cached files only when set to 1 or true.
HF_HUB_OFFLINE=0

# Training process defaults. An existing shell value takes precedence.
TOKENIZERS_PARALLELISM=false
PYTORCH_ALLOC_CONF=expandable_segments:True
# Legacy allocator override; no separate default. Clear PYTORCH_ALLOC_CONF above to use it.
PYTORCH_CUDA_ALLOC_CONF=

# Native environment values supplied by devenv.nix. Paths depend on the Nix store and host,
# so leave path overrides commented unless configuring a different environment.
PYTHONUNBUFFERED=1
# Workspace interpreter: devenv's Python 3.14 executable, with no portable path default.
# UV_PYTHON=
# devenv supplies both Python interpreters and disables uv interpreter downloads.
# UV_PYTHON_DOWNLOADS=never
# devenv's C++ runtime and zlib, plus the Linux driver path, with no portable path default.
# LD_LIBRARY_PATH=
# Linux devenv default; other platforms have no project override.
# TRITON_LIBCUDA_PATH=/run/opengl-driver/lib

# Protected teacher API (apps/harness-api; see docs/harness.md). It wraps the teacher API above.
HARNESS_CALIBRATION_DIR=artifacts/harness
HARNESS_TEACHER_URL=http://127.0.0.1:8000
HARNESS_TEACHER_TOKEN=
# JSON object mapping the SHA-256 hex of each API key to an account ID.
HARNESS_ACCOUNTS_FILE=
HARNESS_POLICY=mmd
HARNESS_ACCUMULATOR=paper
# At L4, refuse (the default and the paper's policy) or answer with cheap keyed noise (deceive).
HARNESS_L4_ACTION=refuse
# Hex secret, at least 16 bytes. Empty reads HARNESS_DECEPTION_KEY_FILE, created on first start.
HARNESS_DECEPTION_KEY=
HARNESS_DECEPTION_KEY_FILE=artifacts/harness/deception.key
# Noise format: ag_news, squad, gsm8k, or text for general chat.
HARNESS_TASK=text
HARNESS_DECISION_LOG=outputs/harness/decisions.jsonl
HARNESS_PORT=8003
